// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid())
  username        String    @unique
  password        String
  gender          Gender
  channelName     String
  banner          String?
  profilePicture  String?
  subscriberCount Int       @default(0)
  description     String?
  uploads         Uploads[]

  // Implicit self many-to-many relation
  subscribers    User[]         @relation("UserFollows")
  subscriptions  User[]         @relation("UserFollows")
  likes          Likes[]
  comments       Comments[]
  watchHistories WatchHistory[]
}

model Uploads {
  id             String         @id @default(uuid())
  videoUrl       String
  thumbnail      String
  description    String
  title          String
  userId         String
  user           User           @relation(fields: [userId], references: [id])
  createdAt      DateTime       @default(now())
  likes          Likes[]
  comments       Comments[]
  watchHistories WatchHistory[]
}

model Likes {
  id      String  @id @default(uuid())
  userId  String
  videoId String
  user    User    @relation(fields: [userId], references: [id])
  video   Uploads @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model Comments {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  comment   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Uploads  @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

model WatchHistory {
  id        String   @id @default(uuid())
  userId    String
  videoId   String
  watchedAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  video     Uploads  @relation(fields: [videoId], references: [id])

  @@unique([userId, videoId])
}

enum Gender {
  Male
  Female
  Other
}
